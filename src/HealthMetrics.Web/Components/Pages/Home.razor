@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IHealthAuthorizationService OAuthService
@inject IHealthSyncService SyncService
@inject IMetricQueryService MetricQueryService
@inject IManualLoadEntryService ManualLoadEntryService
@inject IDemoSeedService DemoSeedService
@inject ILogger<Home> Logger
@inject IJSRuntime JS

<PageTitle>Health Metrics</PageTitle>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
    <h1 class="mb-0">Health Metrics</h1>
    <div class="btn-group btn-group-sm" role="group" aria-label="Date range">
        <button type="button" class="btn @(selectedRange == MetricRange.SevenDays ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => ChangeRangeAsync(MetricRange.SevenDays))">7 d</button>
        <button type="button" class="btn @(selectedRange == MetricRange.ThirtyDays ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => ChangeRangeAsync(MetricRange.ThirtyDays))">30 d</button>
        <button type="button" class="btn @(selectedRange == MetricRange.NinetyDays ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => ChangeRangeAsync(MetricRange.NinetyDays))">90 d</button>
        <button type="button"
                class="btn @(selectedRange == MetricRange.YearToDate ? "btn-primary" : "btn-outline-primary")"
                aria-label="Year to date (since January 1)"
                title="Since January 1"
                @onclick="@(() => ChangeRangeAsync(MetricRange.YearToDate))">YTD</button>
    </div>
</div>
<p class="text-muted mb-3">Daily heart, recovery, manually entered Cardio Load, sleep, fitness, and nutrition metrics persisted locally.</p>

<div class="d-flex flex-wrap gap-2 mb-4">
    @if (connectionStatus?.IsConnected != true)
    {
        <a class="btn btn-primary google-health-connect" href="/api/health/connect" data-google-health-connect>
            <span>Connect Google Health</span>
            <span class="spinner-border spinner-border-sm google-health-connect-spinner" aria-hidden="true"></span>
            <span class="google-health-connect-status" role="status">Opening Google Health...</span>
        </a>
    }
    else
    {
        <button class="btn btn-primary" type="button" @onclick="SyncNowAsync" disabled="@isSyncing">
            @(isSyncing ? "Syncing…" : SyncRangeText)
        </button>
        <a class="btn @(connectionStatus?.RequiresReconnect == true ? "btn-warning" : "btn-outline-secondary") btn-sm align-self-center google-health-connect" href="/api/health/connect" data-google-health-connect>
            <span>@(connectionStatus?.RequiresReconnect == true ? "Reconnect for sleep" : "Reconnect")</span>
            <span class="spinner-border spinner-border-sm google-health-connect-spinner" aria-hidden="true"></span>
            <span class="google-health-connect-status" role="status">Opening Google Health...</span>
        </a>
        <button class="btn btn-outline-danger btn-sm align-self-center" type="button" @onclick="DisconnectAsync">Disconnect</button>
    }
    <button class="btn btn-outline-secondary" type="button" @onclick="LoadDataAsync">Refresh</button>
</div>

@if (!string.IsNullOrWhiteSpace(lastError))
{
    <div class="alert alert-danger" role="alert">@lastError</div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-2">
        <div class="card h-100 @(connectionStatus?.IsConnected == true && connectionStatus.RequiresReconnect != true ? "border-success" : "border-warning")">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-1">Google Health connection</h6>
                @if (connectionStatus?.IsConnected == true)
                {
                    @if (connectionStatus.RequiresReconnect)
                    {
                        <p class="card-text fw-semibold text-warning mb-0">Connected · reconnect required</p>
                        <small class="text-warning d-block">Reconnect to grant sleep access. Other metrics can still sync.</small>
                    }
                    else
                    {
                        <p class="card-text fw-semibold text-success mb-0">Connected ✓</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(connectionStatus.GoogleEmail))
                    {
                        <small class="text-muted d-block">Google account @connectionStatus.GoogleEmail</small>
                    }
                    else if (!string.IsNullOrWhiteSpace(connectionStatus.GoogleUserId))
                    {
                        <small class="text-muted d-block">Google user @connectionStatus.GoogleUserId</small>
                    }
                    @if (connectionStatus.AccessTokenExpiresAtUtc is not null)
                    {
                        <small class="text-muted">Access expires @connectionStatus.AccessTokenExpiresAtUtc.Value.LocalDateTime.ToString("g")</small>
                    }
                }
                else
                {
                    <p class="card-text fw-semibold text-warning mb-0">Not connected</p>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-1">Last sync</h6>
                <p class="card-text fw-semibold mb-0">
                    @(connectionStatus?.LastSuccessfulSyncAtUtc is null
                        ? "—"
                        : connectionStatus.LastSuccessfulSyncAtUtc.Value.LocalDateTime.ToString("g"))
                </p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-1">Resting HR</h6>
                <p class="card-text fw-semibold mb-0">
                    @SummaryText(summary?.LatestRestingHeartRateBpm, summary?.AvgRestingHeartRateBpm7d, "bpm")
                    <span class="@TrendClass(summary?.HeartRateTrend)">@TrendIcon(summary?.HeartRateTrend)</span>
                </p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-1">HRV RMSSD</h6>
                <p class="card-text fw-semibold mb-0">
                    @SummaryText(summary?.LatestHrvRmssd, summary?.AvgHrvRmssd7d, "ms", "F3")
                    <span class="@TrendClass(summary?.HrvTrend)">@TrendIcon(summary?.HrvTrend)</span>
                </p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-1">Manual Cardio Load</h6>
                <p class="card-text fw-semibold mb-0">@CardioLoadText(summary)</p>
                <small class="text-muted d-block">Proprietary, user-entered load and weekly target</small>
                <a class="small" href="#manual-load-entry">Enter or edit manual load</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-1">Manual ACWR</h6>
                <p class="card-text fw-semibold mb-0">
                    @Display(summary?.LatestAcwr, "F2")
                    @if (summary?.LatestAcwr is not null)
                    {
                        <span class="badge @AcwrBadge(summary.LatestAcwrStatus)">@AcwrLabel(summary.LatestAcwrStatus)</span>
                    }
                </p>
                <small class="text-muted">Calculated from manual Cardio Load only</small>
            </div>
        </div>
    </div>
</div>

<section class="card mb-4" id="manual-load-entry" aria-labelledby="manual-load-entry-heading" tabindex="-1">
    <div class="card-header">
        <h2 class="h5 mb-0" id="manual-load-entry-heading">Manual Cardio Load and Weekly Target Load</h2>
    </div>
    <div class="card-body">
        <p class="mb-3" id="manual-load-help">
            Record proprietary manual Cardio Load and a weekly Target Load. Weeks run Monday through Sunday, and the values drive the Manual Cardio ACWR calculation only.
        </p>
        <EditForm Model="manualLoadForm" OnSubmit="SaveManualLoadAsync" FormName="manual-load-entry-form">
            <fieldset aria-describedby="manual-load-help">
                <legend class="fs-6 mb-3">Manual load entry</legend>
                <div class="row g-3">
                    <div class="col-12 col-md-4 col-xl-3">
                        <label class="form-label" for="manual-load-date">Date</label>
                        <InputDate id="manual-load-date"
                                   class="form-control"
                                   @bind-Value="manualLoadForm.MetricDate"
                                   @bind-Value:after="LoadManualInputsForSelectedDate"
                                   aria-describedby="manual-load-date-help" />
                        <div class="form-text" id="manual-load-date-help">Choose the day to update.</div>
                    </div>
                    <div class="col-12 col-md-4 col-xl-3">
                        <label class="form-label" for="manual-cardio-load">Cardio Load (load points)</label>
                        <InputNumber id="manual-cardio-load"
                                     class="form-control"
                                     @bind-Value="manualLoadForm.CardioLoad"
                                     min="0"
                                     step="0.1"
                                     inputmode="decimal"
                                     aria-describedby="manual-cardio-load-help" />
                        <div class="form-text" id="manual-cardio-load-help">Optional proprietary daily load.</div>
                    </div>
                    <div class="col-12 col-md-4 col-xl-3">
                        <label class="form-label" for="manual-target">Weekly Target (load points)</label>
                        <InputNumber id="manual-target"
                                     class="form-control"
                                     @bind-Value="manualLoadForm.TargetLoad"
                                     min="0"
                                     step="0.1"
                                     inputmode="decimal"
                                     aria-describedby="manual-target-help" />
                        <div class="form-text" id="manual-target-help">Optional Monday–Sunday target amount.</div>
                    </div>
                </div>
                <p class="form-text mb-3">
                    All load fields are optional. Leave a value blank and save to clear that existing manual value.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-primary" type="submit" disabled="@isSavingManual">
                        @(isSavingManual ? "Saving…" : "Save manual load")
                    </button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="ResetManualLoadInputs" disabled="@isSavingManual">
                        Reset unsaved changes
                    </button>
                    <button class="btn btn-outline-danger" type="button" @onclick="BeginManualLoadClear" disabled="@isSavingManual">
                        Clear saved values
                    </button>
                </div>
            </fieldset>
        </EditForm>
        @if (isConfirmingManualClear)
        {
            <div class="alert alert-warning mt-3 mb-0" role="alert" id="manual-load-clear-confirmation">
                <p class="mb-2">
                    Clear the saved manual Cardio Load for @manualLoadForm.MetricDate.ToString("MMMM d, yyyy") and the weekly Target Load for the week starting @WeeklyLoadCalculator.GetWeekStart(manualLoadForm.MetricDate).ToString("MMMM d, yyyy")?
                    Other saved health metrics will not be changed.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-danger" type="button" @onclick="ClearManualLoadAsync" disabled="@isSavingManual">
                        Yes, clear saved values
                    </button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="CancelManualLoadClear" disabled="@isSavingManual">
                        Cancel
                    </button>
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(manualEntryMessage))
        {
            <div class="alert @(manualEntryError ? "alert-danger" : "alert-success") mt-3 mb-0"
                 role="@(manualEntryError ? "alert" : "status")"
                 aria-live="@(manualEntryError ? "assertive" : "polite")"
                 id="manual-load-feedback">
                @manualEntryMessage
            </div>
        }
    </div>
</section>

@if (HasHeartMetrics || HasLoadMetrics)
{
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
            <span class="fw-semibold">@(chartMode == ChartMode.Load ? "Daily Cardio Load & weekly accumulation" : "Heart rate & HRV trend")</span>
            <div class="btn-group btn-group-sm" role="group" aria-label="Chart metric">
                <button type="button" class="btn @(chartMode == ChartMode.Heart ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => SetChartModeAsync(ChartMode.Heart))" disabled="@(!HasHeartMetrics)">Heart &amp; HRV</button>
                <button type="button" class="btn @(chartMode == ChartMode.Load ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => SetChartModeAsync(ChartMode.Load))" disabled="@(!HasLoadMetrics)">Load</button>
            </div>
        </div>
        <div class="card-body py-2">
            <canvas id="metricsChart" style="max-height: 260px;"></canvas>
        </div>
    </div>
}

<div class="d-flex align-items-baseline justify-content-between mb-2">
    <h2 class="h5 mb-0">Daily snapshots</h2>
    <div class="d-flex align-items-center gap-3">
        <a href="/api/metrics/export?days=@SelectedDayCount" class="small text-decoration-none" download>⬇ Export CSV</a>
        <small class="text-muted">@metrics.Count of @SelectedDayCount days · — = not recorded for that date</small>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-striped table-sm table-hover">
        <thead>
            <tr>
                <th><button type="button" class="btn btn-link p-0 text-reset text-decoration-none" @onclick="@(() => SortBy("date"))">Date @SortIndicator("date")</button></th>
                <th class="border-start"><button type="button" class="btn btn-link p-0 text-reset text-decoration-none" @onclick="@(() => SortBy("restingHr"))">Resting HR @SortIndicator("restingHr")</button></th>
                <th><button type="button" class="btn btn-link p-0 text-reset text-decoration-none" @onclick="@(() => SortBy("hrv"))">HRV (ms) @SortIndicator("hrv")</button></th>
                <th class="border-start"><button type="button" class="btn btn-link p-0 text-reset text-decoration-none" @onclick="@(() => SortBy("dailyVo2"))">Daily VO2 Max @SortIndicator("dailyVo2")</button></th>
                <th><button type="button" class="btn btn-link p-0 text-reset text-decoration-none" @onclick="@(() => SortBy("runVo2"))">Run VO2 Max @SortIndicator("runVo2")</button></th>
                <th class="border-start"><button type="button" class="btn btn-link p-0 text-reset text-decoration-none" @onclick="@(() => SortBy("cardioLoad"))">Cardio Load (Manual) @SortIndicator("cardioLoad")</button></th>
                <th><button type="button" class="btn btn-link p-0 text-reset text-decoration-none" @onclick="@(() => SortBy("targetLoad"))">Target Load (Manual) @SortIndicator("targetLoad")</button></th>
                <th><button type="button" class="btn btn-link p-0 text-reset text-decoration-none" @onclick="@(() => SortBy("acwr"))">ACWR @SortIndicator("acwr")</button></th>
                <th class="border-start"><button type="button" class="btn btn-link p-0 text-reset text-decoration-none" @onclick="@(() => SortBy("sleepEfficiency"))">Sleep Efficiency (%) @SortIndicator("sleepEfficiency")</button></th>
                <th class="border-start"><button type="button" class="btn btn-link p-0 text-reset text-decoration-none" @onclick="@(() => SortBy("calories"))">Calories @SortIndicator("calories")</button></th>
                <th><button type="button" class="btn btn-link p-0 text-reset text-decoration-none" @onclick="@(() => SortBy("carbs"))">Carbs (g) @SortIndicator("carbs")</button></th>
                <th><button type="button" class="btn btn-link p-0 text-reset text-decoration-none" @onclick="@(() => SortBy("fat"))">Fat (g) @SortIndicator("fat")</button></th>
                <th><button type="button" class="btn btn-link p-0 text-reset text-decoration-none" @onclick="@(() => SortBy("protein"))">Protein (g) @SortIndicator("protein")</button></th>
            </tr>
        </thead>
        <tbody>
            @if (metrics.Count == 0)
            {
                <tr>
                    <td colspan="13" class="text-center text-muted py-3">
                        @(connectionStatus?.IsConnected == true
                            ? "No data for this range — run a sync first."
                            : "Connect Google Health and run sync to start tracking.")
                    </td>
                </tr>
            }
            else
            {
                @foreach (var metric in SortedMetrics)
                {
                    <tr>
                        <td>@metric.MetricDate.ToString("ddd, MMM d")</td>
                        <td class="border-start">@Display(metric.RestingHeartRateBpm)</td>
                        <td>@Display(metric.HrvRmssdMilliseconds, "F3")</td>
                        <td class="border-start">@Display(metric.DailyVo2MaxMlKgMin, "F1")</td>
                        <td>@Display(metric.RunVo2MaxMlKgMin)</td>
                        <td class="border-start">@Display(metric.CardioLoad, "F1")</td>
                        <td>@TargetLoadText(metric.TargetLoad)</td>
                        <td>@Display(metric.Acwr, "F2")</td>
                        <td class="border-start">@Display(metric.SleepEfficiency, "F2")</td>
                        <td class="border-start">@Display(metric.ConsumedCaloriesKcal)</td>
                        <td>@Display(metric.CarbohydratesGrams, "F2")</td>
                        <td>@Display(metric.FatGrams, "F2")</td>
                        <td>@Display(metric.ProteinGrams, "F2")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (syncHistory.Count > 0)
{
    <details class="mt-4">
        <summary class="text-muted small mb-2" style="cursor:pointer;">Sync history (last @syncHistory.Count)</summary>
        <div class="table-responsive">
            <table class="table table-sm table-borderless">
                <thead>
                    <tr class="text-muted">
                        <th>Started</th>
                        <th>Outcome</th>
                        <th>Days</th>
                        <th>Duration</th>
                        <th>Error</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in syncHistory)
                    {
                        <tr>
                            <td>@entry.StartedAtUtc.LocalDateTime.ToString("g")</td>
                            <td>
                                <span class="badge @OutcomeBadge(entry.Outcome)">@entry.Outcome</span>
                            </td>
                            <td>@entry.PersistedDays / @entry.RequestedDays</td>
                            <td>@SyncDuration(entry)</td>
                            <td class="text-danger small">@entry.ErrorMessage</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
}

@if (metrics.Count == 0)
{
    <div class="mt-4 p-3 border rounded bg-body-tertiary">
        <p class="mb-2 text-muted small">
            <strong>No Google Health consent yet?</strong> Seed 30 days of synthetic demo data to explore the dashboard.
        </p>
        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="SeedDemoDataAsync" disabled="@isSeeding">
            @(isSeeding ? "Seeding…" : "Insert demo data (30 days)")
        </button>
        @if (!string.IsNullOrWhiteSpace(seedMessage))
        {
            <span class="ms-2 text-muted small">@seedMessage</span>
        }
    </div>
}

@code {
    private readonly CancellationTokenSource _cts = new();
    private readonly List<DailyMetricSnapshot> metrics = [];
    private readonly List<DailyMetricSnapshot> loadHistory = [];
    private readonly List<SyncHistoryEntry> syncHistory = [];
    private HealthConnectionStatus? connectionStatus;
    private MetricSummary? summary;
    private bool isSyncing;
    private bool isSeeding;
    private bool isSavingManual;
    private bool manualEntryError;
    private string? lastError;
    private string? seedMessage;
    private string? manualEntryMessage;
    private readonly ManualLoadForm manualLoadForm = new(DateOnly.FromDateTime(DateTime.UtcNow));
    private bool isConfirmingManualClear;
    private MetricRange selectedRange = MetricRange.ThirtyDays;
    private bool chartNeedsRender;
    private ChartMode chartMode = ChartMode.Heart;
    private string sortColumn = "date";
    private bool sortDescending = true;

    private bool HasHeartMetrics =>
        metrics.Any(m => m.RestingHeartRateBpm.HasValue || m.HrvRmssdMilliseconds.HasValue);

    private bool HasLoadMetrics =>
        loadHistory.Any(m => m.CardioLoad.HasValue
            || m.TargetLoad.HasValue
            || m.Acwr.HasValue);

    private int YearToDateDays =>
        DateOnly.FromDateTime(DateTime.UtcNow).DayOfYear;

    private bool IsYearToDate => selectedRange == MetricRange.YearToDate;

    private int SelectedDayCount =>
        IsYearToDate ? YearToDateDays : (int)selectedRange;

    private string SyncRangeText =>
        IsYearToDate ? "Sync since January 1" : $"Sync last {SelectedDayCount} days";

    private IEnumerable<DailyMetricSnapshot> SortedMetrics =>
        sortColumn switch
        {
            "restingHr" => Sort(metrics, metric => metric.RestingHeartRateBpm),
            "hrv" => Sort(metrics, metric => metric.HrvRmssdMilliseconds),
            "dailyVo2" => Sort(metrics, metric => metric.DailyVo2MaxMlKgMin),
            "runVo2" => Sort(metrics, metric => metric.RunVo2MaxMlKgMin),
            "cardioLoad" => Sort(metrics, metric => metric.CardioLoad),
            "targetLoad" => Sort(metrics, metric => metric.TargetLoad),
            "acwr" => Sort(metrics, metric => metric.Acwr),
            "sleepEfficiency" => Sort(metrics, metric => metric.SleepEfficiency),
            "calories" => Sort(metrics, metric => metric.ConsumedCaloriesKcal),
            "carbs" => Sort(metrics, metric => metric.CarbohydratesGrams),
            "fat" => Sort(metrics, metric => metric.FatGrams),
            "protein" => Sort(metrics, metric => metric.ProteinGrams),
            _ => Sort(metrics, metric => metric.MetricDate)
        };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var chartHasData = chartMode == ChartMode.Load ? HasLoadMetrics : HasHeartMetrics;
        if (chartNeedsRender && chartHasData)
        {
            chartNeedsRender = false;
            var ordered = (chartMode == ChartMode.Load ? loadHistory : metrics)
                .OrderBy(m => m.MetricDate)
                .ToList();
            if (chartMode == ChartMode.Load)
            {
                var dailyLoad = WeeklyLoadCalculator.BuildDailySeries(ordered);
                var labels = dailyLoad
                    .Select(day => day.MetricDate.ToString("ddd, MMM d"))
                    .ToArray();
                var dailyCardioLoadData = dailyLoad.Select(day => (object?)day.CardioLoad).ToArray();
                var cumulativeCardioLoadData = dailyLoad.Select(day => (object?)day.CumulativeCardioLoad).ToArray();
                var targetData = dailyLoad.Select(day => (object?)day.TargetLoad).ToArray();
                var manualAcwrData = dailyLoad.Select(day => (object?)day.Acwr).ToArray();
                var weekStarts = dailyLoad.Select(day => day.WeekStart.ToString("yyyy-MM-dd")).ToArray();
                await JS.InvokeVoidAsync(
                    "HealthCharts.renderLoad",
                    "metricsChart",
                    labels,
                    dailyCardioLoadData,
                    cumulativeCardioLoadData,
                    targetData,
                    manualAcwrData,
                    weekStarts);
            }
            else
            {
                var labels = ordered.Select(m => m.MetricDate.ToString("MMM d")).ToArray();
                var hrData   = ordered.Select(m => (object?)(m.RestingHeartRateBpm.HasValue ? m.RestingHeartRateBpm.Value : (int?)null)).ToArray();
                var hrvData  = ordered.Select(m => (object?)(m.HrvRmssdMilliseconds.HasValue ? (double)m.HrvRmssdMilliseconds.Value : (double?)null)).ToArray();
                await JS.InvokeVoidAsync("HealthCharts.render", "metricsChart", labels, hrData, hrvData);
            }
        }
    }

    private async Task SetChartModeAsync(ChartMode mode)
    {
        if (mode == ChartMode.Load && !HasLoadMetrics)
            return;

        chartMode = mode;
        chartNeedsRender = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SyncNowAsync()
    {
        var dayCount = SelectedDayCount;
        try
        {
            lastError = null;
            isSyncing = true;
            StateHasChanged();
            await SyncService.SyncRecentDaysAsync(dayCount, _cts.Token);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Manual sync failed for {Days} days.", dayCount);
            lastError = "Sync failed. Check the application logs for details.";
        }
        finally
        {
            isSyncing = false;
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            lastError = null;
            var dayCount = SelectedDayCount;
            connectionStatus = await OAuthService.GetConnectionStatusAsync(_cts.Token);
            var loaded = await MetricQueryService.GetRecentMetricsAsync(dayCount, _cts.Token);
            var loadedLoadHistory = await MetricQueryService.GetAllMetricsAsync(_cts.Token);
            metrics.Clear();
            metrics.AddRange(loaded);
            loadHistory.Clear();
            loadHistory.AddRange(loadedLoadHistory);
            if (!HasHeartMetrics && HasLoadMetrics)
                chartMode = ChartMode.Load;
            else if (chartMode == ChartMode.Load && !HasLoadMetrics)
                chartMode = ChartMode.Heart;
            summary = MetricSummary.From(metrics);
            var history = await MetricQueryService.GetRecentSyncHistoryAsync(10, _cts.Token);
            syncHistory.Clear();
            syncHistory.AddRange(history);
            chartNeedsRender = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load dashboard data.");
            lastError = "Failed to load data. Check the application logs for details.";
        }
    }

    private async Task ChangeRangeAsync(MetricRange range)
    {
        selectedRange = range;
        await LoadDataAsync();
    }

    private async Task SaveManualLoadAsync()
    {
        try
        {
            isSavingManual = true;
            manualEntryMessage = null;
            var result = await ManualLoadEntryService.SaveAsync(
                new ManualLoadEntry(
                    manualLoadForm.MetricDate,
                    manualLoadForm.CardioLoad,
                    manualLoadForm.TargetLoad),
                _cts.Token);
            manualEntryError = !result.Succeeded;
            manualEntryMessage = result.Succeeded
                ? "Manual Cardio Load and weekly Target Load saved."
                : result.ErrorMessage;
            if (result.Succeeded)
            {
                isConfirmingManualClear = false;
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving manual Cardio Load failed.");
            manualEntryError = true;
            manualEntryMessage = "Manual Cardio Load could not be saved. Check the application logs for details.";
        }
        finally
        {
            isSavingManual = false;
        }
    }

    private void LoadManualInputsForSelectedDate() => ResetManualLoadInputs();

    private void ResetManualLoadInputs()
    {
        var snapshot = loadHistory.SingleOrDefault(metric => metric.MetricDate == manualLoadForm.MetricDate);
        var weekStart = WeeklyLoadCalculator.GetWeekStart(manualLoadForm.MetricDate);
        manualLoadForm.CardioLoad = snapshot?.CardioLoad;
        manualLoadForm.TargetLoad = loadHistory
            .Where(metric => WeeklyLoadCalculator.GetWeekStart(metric.MetricDate) == weekStart)
            .OrderByDescending(metric => metric.MetricDate)
            .Select(metric => metric.TargetLoad)
            .FirstOrDefault(target => target.HasValue);
        isConfirmingManualClear = false;
        manualEntryError = false;
        manualEntryMessage = "Unsaved changes were reset to the saved values for this date.";
    }

    private void BeginManualLoadClear()
    {
        isConfirmingManualClear = true;
        manualEntryMessage = null;
    }

    private void CancelManualLoadClear() => isConfirmingManualClear = false;

    private async Task ClearManualLoadAsync()
    {
        manualLoadForm.CardioLoad = null;
        manualLoadForm.TargetLoad = null;
        await SaveManualLoadAsync();
    }

    private async Task DisconnectAsync()
    {
        try
        {
            lastError = null;
            await OAuthService.DisconnectAsync(_cts.Token);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Disconnect from Google Health failed.");
            lastError = "Disconnect failed. Check the application logs for details.";
        }
    }

    private async Task SeedDemoDataAsync()
    {
        try
        {
            isSeeding   = true;
            seedMessage = null;
            StateHasChanged();
            var inserted = await DemoSeedService.SeedAsync(30, _cts.Token);
            seedMessage = $"{inserted} day(s) of demo data inserted.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Demo data seed failed.");
            seedMessage = "Demo seed failed. Check the application logs for details.";
        }
        finally
        {
            isSeeding = false;
        }
    }

    private static string Display<T>(T? value, string? format = null)
        where T : struct, IFormattable =>
        value is null ? "—" : value.Value.ToString(format, System.Globalization.CultureInfo.CurrentCulture);

    private static string CardioLoadText(MetricSummary? metricSummary)
    {
        if (metricSummary?.LatestCardioLoad is null)
            return "—";

        return $"{metricSummary.LatestCardioLoad.Value:F1} / Weekly target: {TargetLoadText(metricSummary.LatestTargetLoad)}";
    }

    private static string TargetLoadText(decimal? target)
    {
        return target?.ToString("F1", System.Globalization.CultureInfo.CurrentCulture) ?? "—";
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
    }

    private IEnumerable<DailyMetricSnapshot> Sort<T>(
        IEnumerable<DailyMetricSnapshot> source,
        Func<DailyMetricSnapshot, T> selector) =>
        sortDescending ? source.OrderByDescending(selector) : source.OrderBy(selector);

    private string SortIndicator(string column) =>
        sortColumn == column ? (sortDescending ? "▼" : "▲") : string.Empty;

    private static string AcwrLabel(AcwrStatus status) => status switch
    {
        AcwrStatus.Undertraining => "Undertraining",
        AcwrStatus.OptimalZone => "Optimal Zone",
        AcwrStatus.Overreaching => "Overreaching",
        AcwrStatus.HighDangerZone => "High Danger Zone",
        _ => "Insufficient data"
    };

    private static string AcwrBadge(AcwrStatus status) => status switch
    {
        AcwrStatus.Undertraining => "bg-warning text-dark",
        AcwrStatus.OptimalZone => "bg-success",
        AcwrStatus.Overreaching => "bg-orange text-dark",
        AcwrStatus.HighDangerZone => "bg-danger",
        _ => "bg-secondary"
    };

    private static string SummaryText(object? latest, double? avg7d, string unit, string decimalFormat = "F1")
    {
        if (latest is null) return "—";
        var latestStr = latest is decimal d ? d.ToString(decimalFormat) : latest.ToString()!;
        var avgStr    = avg7d is null ? "—" : avg7d.Value.ToString(decimalFormat);
        return $"{latestStr} {unit}  ·  avg {avgStr}";
    }

    private static string TrendIcon(TrendDirection? trend) => trend switch
    {
        TrendDirection.Up       => " ↑",
        TrendDirection.Down     => " ↓",
        TrendDirection.Stable   => " →",
        _                       => ""
    };

    private static string TrendClass(TrendDirection? trend) => trend switch
    {
        TrendDirection.Up or TrendDirection.Down => "text-primary",
        TrendDirection.Stable                    => "text-secondary",
        _                                        => ""
    };

    private static string OutcomeBadge(SyncOutcome outcome) => outcome switch
    {
        SyncOutcome.Success        => "bg-success",
        SyncOutcome.Failed         => "bg-danger",
        SyncOutcome.PartialSuccess => "bg-warning text-dark",
        _                          => "bg-secondary"
    };

    private static string SyncDuration(SyncHistoryEntry entry)
    {
        if (entry.CompletedAtUtc is null) return "—";
        var span = entry.CompletedAtUtc.Value - entry.StartedAtUtc;
        return span.TotalSeconds < 60
            ? $"{span.TotalSeconds:F0}s"
            : $"{span.TotalMinutes:F1}m";
    }

    private enum ChartMode
    {
        Heart,
        Load
    }

    private enum MetricRange
    {
        SevenDays = 7,
        ThirtyDays = 30,
        NinetyDays = 90,
        YearToDate
    }

    private sealed class ManualLoadForm(DateOnly metricDate)
    {
        public DateOnly MetricDate { get; set; } = metricDate;
        public decimal? CardioLoad { get; set; }
        public decimal? TargetLoad { get; set; }
    }
