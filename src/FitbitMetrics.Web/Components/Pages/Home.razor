@page "/"
@rendermode InteractiveServer
@inject IFitbitOAuthService OAuthService
@inject IFitbitSyncService SyncService
@inject IMetricQueryService MetricQueryService

<PageTitle>Fitbit Metrics Dashboard</PageTitle>

<h1>Fitbit Metrics Dashboard</h1>

<p>
    Your daily Fitbit health and nutrition metrics, synced from the Fitbit Web API and stored locally.
    Connect once, sync as often as you like, and track trends over time.
</p>

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-primary" href="/api/fitbit/connect">Connect Fitbit</a>
    <button class="btn btn-outline-primary" type="button" @onclick="SyncNowAsync" disabled="@isSyncing">
        @(isSyncing ? "Syncing..." : "Sync last 7 days")
    </button>
    <button class="btn btn-outline-secondary" type="button" @onclick="LoadDataAsync">Refresh dashboard</button>
</div>

@if (!string.IsNullOrWhiteSpace(lastError))
{
    <div class="alert alert-danger" role="alert">@lastError</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Connection</h5>
                <p class="card-text">
                    @(connectionStatus?.IsConnected == true ? "Connected" : "Not connected")
                </p>
                @if (connectionStatus?.AccessTokenExpiresAtUtc is not null)
                {
                    <small class="text-muted">Token expires: @connectionStatus.AccessTokenExpiresAtUtc.Value.LocalDateTime</small>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Last successful sync</h5>
                <p class="card-text">
                    @(connectionStatus?.LastSuccessfulSyncAtUtc?.LocalDateTime.ToString("g") ?? "No sync yet")
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Loaded snapshots</h5>
                <p class="card-text">@metrics.Count</p>
            </div>
        </div>
    </div>
</div>

<h2>Recent daily metrics</h2>
<p class="text-muted">
    Empty values mean Fitbit did not return that metric for the day/account/device.
</p>

<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>Date</th>
                <th>Resting HR</th>
                <th>HRV (RMSSD)</th>
                <th>VO2 Max</th>
                <th>Calories</th>
                <th>Carbs</th>
                <th>Fat</th>
                <th>Protein</th>
                <th>Fiber</th>
                <th>Sodium (mg)</th>
                <th>Potassium (mg)</th>
                <th>Calcium (mg)</th>
                <th>Iron (mg)</th>
            </tr>
        </thead>
        <tbody>
            @if (metrics.Count == 0)
            {
                <tr>
                    <td colspan="13" class="text-center">No data yet. Connect Fitbit and run sync.</td>
                </tr>
            }
            else
            {
                @foreach (var metric in metrics)
                {
                    <tr>
                        <td>@metric.MetricDate</td>
                        <td>@Display(metric.RestingHeartRateBpm)</td>
                        <td>@Display(metric.HrvRmssdMilliseconds)</td>
                        <td>@Display(metric.Vo2MaxMlKgMin)</td>
                        <td>@Display(metric.ConsumedCaloriesKcal)</td>
                        <td>@Display(metric.CarbohydratesGrams)</td>
                        <td>@Display(metric.FatGrams)</td>
                        <td>@Display(metric.ProteinGrams)</td>
                        <td>@Display(metric.FiberGrams)</td>
                        <td>@Display(metric.SodiumMilligrams)</td>
                        <td>@Display(metric.PotassiumMilligrams)</td>
                        <td>@Display(metric.CalciumMilligrams)</td>
                        <td>@Display(metric.IronMilligrams)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private readonly List<DailyMetricSnapshot> metrics = [];
    private FitbitConnectionStatus? connectionStatus;
    private bool isSyncing;
    private string? lastError;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task SyncNowAsync()
    {
        try
        {
            lastError = null;
            isSyncing = true;
            await SyncService.SyncRecentDaysAsync(7);
            await LoadDataAsync();
        }
        catch (Exception exception)
        {
            lastError = exception.Message;
        }
        finally
        {
            isSyncing = false;
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            lastError = null;
            connectionStatus = await OAuthService.GetConnectionStatusAsync();
            var recentMetrics = await MetricQueryService.GetRecentMetricsAsync(30);
            metrics.Clear();
            metrics.AddRange(recentMetrics);
        }
        catch (Exception exception)
        {
            lastError = exception.Message;
        }
    }

    private static string Display<T>(T? value) where T : struct
        => value is null ? "—" : value.Value.ToString() ?? "—";
}
