# Copy this file to .env in the repository root, then fill in the values
# you need. .env is gitignored (see .gitignore) - never commit real secrets.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS/Linux:            cp .env.example .env
#
# Full step-by-step setup: docs/docker-setup.md

# --- Google Health OAuth (optional) -----------------------------------------
# Leave both commented out to run in demo mode without live Google sync; the
# app falls back to the tracked appsettings.json placeholders and starts
# normally. Uncomment and fill in only after completing
# docs/google-health-setup.md, using the SAME client used for native runs.
# GoogleHealthApi__ClientId=
# GoogleHealthApi__ClientSecret=

# --- HTTPS development certificate (required) -------------------------------
# Absolute host path to the folder containing the exported dev certificate
# pfx file. docs/docker-setup.md shows the export command.
#   Windows example:      DEV_CERT_DIR=C:/Users/<you>/.aspnet/https-docker
#   macOS/Linux example:   DEV_CERT_DIR=/home/<you>/.aspnet/https-docker
DEV_CERT_DIR=

# Password used when exporting the pfx above. Any value works - it only
# protects the local file and is never transmitted anywhere. Avoid spaces,
# quotes, and the # character.
DEV_CERT_PASSWORD=

# --- Local request policy (required to reach the dashboard from a browser) --
# CIDR range trusted in addition to loopback. The default below covers
# Docker's standard private bridge address space (172.16.0.0-172.31.255.255)
# so it works out of the box. Narrow it to your exact bridge gateway for a
# tighter allowlist - docs/docker-setup.md shows how to find it.
#
# Only private, loopback, and link-local ranges are accepted. A public or
# catch-all value such as 0.0.0.0/0 is rejected at startup and logged, so it
# cannot be used to expose the dashboard beyond your machine.
DOCKER_TRUSTED_NETWORK=172.16.0.0/12
